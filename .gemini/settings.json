{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "timeout": 60000,
      "trust": false
    },
    "semgrep": {
      "command": "semgrep",
      "args": ["mcp"],
      "timeout": 60000,
      "trust": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "timeout": 30000,
      "trust": false
    }
  }
}
